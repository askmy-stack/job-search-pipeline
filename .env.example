# Copy to .env and fill in values. Never commit .env.

# Anthropic API (required for evaluation tasks: oferta, pdf, apply, deep)
ANTHROPIC_API_KEY=

# Ollama (optional — local discovery tasks: fresh, scan, tracker, training)
# Host may be host:port or a full http URL.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=gemma4:27b
OLLAMA_TIMEOUT=30000

# API bridge HTTP server (optional)
# When set, clients must send X-Bridge-Api-Key or Authorization: Bearer <key>
BRIDGE_API_KEY=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
