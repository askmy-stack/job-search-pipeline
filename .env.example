# Anthropic API (required for evaluation tasks)
ANTHROPIC_API_KEY=

# Ollama (optional — local discovery tasks)
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=gemma4:27b
OLLAMA_TIMEOUT=30000

# API bridge HTTP server (optional)
# When set, clients must send X-Bridge-Api-Key or Authorization: Bearer <key>
BRIDGE_API_KEY=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
